{
  "name": "slimpic",
  "version": "1.2.0",
  "description": "批量图片压缩工具（slimdeer 引擎，原地覆盖，递归扫描）",
  "main": "out/main/index.js",
  "author": "happyelements",
  "license": "MIT",
  "scripts": {
    "fetch": "node scripts/fetch-slimdeer.mjs",
    "postinstall": "node scripts/fetch-slimdeer.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "smoke": "node scripts/smoke-slimdeer.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "dist": "npm run build && electron-builder --win portable --x64",
    "dist:mac": "npm run build && node scripts/make-icon.mjs --icns-only && electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.49.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue": "^3.5.13"
  }
}
